rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    match /domains/{domainId} {
      function isFromDomain() {
        return request.auth != null
          && (domainId == 'public' || (request.auth.token.email != null && request.auth.token.email.lower().split('@')[1] == domainId));
      }

      allow read, write: if isFromDomain();

      match /users/{userId} {
        allow read: if isFromDomain();
        allow write: if isFromDomain() && request.auth.uid == userId;
      }

      match /runs/{runId} {
        allow read: if isFromDomain();
        allow create: if isFromDomain();
        allow update: if isFromDomain() && resource.data.runnerId == request.auth.uid;
        allow delete: if isFromDomain() && resource.data.runnerId == request.auth.uid;

        match /orders/{orderId} {
          allow read: if isFromDomain();
          allow create: if isFromDomain();
          allow update, delete: if isFromDomain() && resource.data.userId == request.auth.uid;
        }
      }

      match /waitlist/{waitId} {
        allow read: if isFromDomain();
        allow create: if isFromDomain();
        allow update, delete: if isFromDomain() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
